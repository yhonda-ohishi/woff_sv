# WOFF (LINE WORKS) OAuth Configuration
WOFF_CLIENT_ID=your-woff-client-id
WOFF_CLIENT_SECRET=your-woff-client-secret
WOFF_REDIRECT_URI=http://localhost:8080/callback

# Server Configuration
GRPC_PORT=50051

# Database Configuration
DATABASE_PATH=woff.db

# Cloudflare Tunnel Configuration
# Set to "true" to enable public URL via Cloudflare Tunnel
# Requires cloudflared to be installed: https://developers.cloudflare.com/cloudflare-one/connections/connect-apps/install-and-setup/installation/
ENABLE_CLOUDFLARED=false

# Frontend Registration Configuration
# Set these to automatically register backend URL with frontend when using Cloudflare Tunnel
FRONTEND_URL=https://ohishi-pwa-woff.mtamaramu.com
FRONTEND_SECRET=your-frontend-secret-here

# JWT Configuration (for legacy/alternative auth)
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_TOKEN_DURATION=15m

# LINE Login Configuration
# Get these values from LINE Developers Console: https://developers.line.biz/console/
# LINE_CHANNEL_ID = "Channel ID" from Basic settings tab
# LINE_CHANNEL_SECRET = "Channel secret" from Basic settings tab
LINE_CHANNEL_ID=your_line_channel_id_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_REDIRECT_URI=http://localhost:8080/callback

# Production Database Configuration (Read-Only)
# Used for timecard endpoints with DB_ENVIRONMENT_PROD
PROD_DB_HOST=192.168.0.151
PROD_DB_PORT=3306
PROD_DB_USER=your_prod_db_user
PROD_DB_PASSWORD=your_prod_db_password
PROD_DB_NAME=db1

# Development Database Configuration (Read-Write)
# Used for timecard endpoints with DB_ENVIRONMENT_DEV
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_dev_db_user
DB_PASSWORD=your_dev_db_password
DB_NAME=db1
