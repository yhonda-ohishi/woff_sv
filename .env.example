# WOFF (LINE WORKS) OAuth Configuration
WOFF_CLIENT_ID=your-woff-client-id
WOFF_CLIENT_SECRET=your-woff-client-secret
WOFF_REDIRECT_URI=http://localhost:8080/callback

# Server Configuration
GRPC_PORT=50051

# Database Configuration
DATABASE_PATH=woff.db

# Cloudflare Tunnel Configuration
# Set to "true" to enable public URL via Cloudflare Tunnel
# Requires cloudflared to be installed: https://developers.cloudflare.com/cloudflare-one/connections/connect-apps/install-and-setup/installation/
ENABLE_CLOUDFLARED=false

# JWT Configuration (for legacy/alternative auth)
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_TOKEN_DURATION=15m
